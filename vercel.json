{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__orig_path__=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__orig_path__=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__orig_path__=/health"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,data/okf/**}"
    }
  }
}

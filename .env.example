# ==============================================================================
# Before You Pay - Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# API & Gateway Configuration
API_PREFIX=/api/v1
# CORS_ORIGINS supports JSON array string, e.g. ["https://before-you-pay-sys.vercel.app"], comma-separated URLs, or wildcard "*"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Document Ingestion & Storage
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# OCR Engine Configuration
# Keep this aligned with the OCR provider configured in src/before_you_pay/services/ocr.py.
OCR_ENGINE=spatial_layout_ocr
OCR_USE_GPU=false

# User Document RAG Store (SQLite token-overlap retrieval; no vector embeddings)
RAG_DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30

# Open Knowledge Format (OKF) Catalog (Curated System Rules)
OKF_CATALOG_PATH=./data/okf
OKF_SCHEMA_VERSION=1.0.0

# LLM Engine Configuration with fallback key pool (default provider: Gemini)
LLM_PROVIDER=gemini
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_MODEL=qwen/qwen3.8-27b

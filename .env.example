# ==============================================================================
# Before You Pay - Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# API & Gateway Configuration
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Document Ingestion & Storage
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25

# OCR Engine Configuration (Planned: PaddleOCR)
OCR_ENGINE=paddleocr
OCR_USE_GPU=false

# User Document RAG Store (Planned: Chroma)
RAG_CHROMA_PERSIST_DIRECTORY=./data/chroma
RAG_DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70

# Open Knowledge Format (OKF) Catalog (Curated System Rules)
OKF_CATALOG_PATH=./data/okf
OKF_SCHEMA_VERSION=1.0.0

# LLM Engine Configuration with Fallback Key Pool (Groq High-Speed Inference)
LLM_PROVIDER=groq
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_MODEL=qwen/qwen3.8-27b
